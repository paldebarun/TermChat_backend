# =========================
# Database
# =========================

DATABASE_URL=postgresql+asyncpg://chat_user:chat_password@db:5432/chat_db


# =========================
# JWT Authentication
# =========================

JWT_SECRET_KEY=Debarun
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7


# =========================
# CORS
# =========================

CORS_ORIGINS=["*"]


# =========================
# MinIO
# =========================

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# Backend -> MinIO inside Docker network
MINIO_INTERNAL_ENDPOINT=http://minio:9000

# Browser -> MinIO from host machine
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

MINIO_BUCKET_NAME=chat-attachments
MINIO_REGION=us-east-1


# =========================
# Presigned URLs
# =========================

PRESIGNED_URL_EXPIRY_SECONDS=3600


# =========================
# Multipart Upload
# =========================

UPLOAD_DEFAULT_CHUNK_SIZE_MB=10
UPLOAD_INIT_BATCH_SIZE=20


# =========================
# Orphan File Cleanup
# =========================

ORPHAN_CLEANUP_INTERVAL_MINUTES=30
ORPHAN_CLEANUP_THRESHOLD_MINUTES=60