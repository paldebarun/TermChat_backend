# =========================
# Database
# =========================

DATABASE_URL=postgresql+asyncpg://chat_user:chat_password@db:5432/chat_db


# =========================
# JWT Authentication
# =========================

# Generate: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7


# =========================
# CORS
# =========================

CORS_ORIGINS=["*"]


# =========================
# S3 object storage (SeaweedFS; keys must match seaweedfs/s3.json)
# =========================

S3_ACCESS_KEY=seaweedadmin
S3_SECRET_KEY=seaweedadmin123

# Backend -> SeaweedFS inside Docker network
S3_INTERNAL_ENDPOINT=http://seaweedfs:8333

# Browser -> SeaweedFS from host machine
S3_PUBLIC_ENDPOINT=http://localhost:8333

S3_BUCKET_NAME=chat-attachments
S3_REGION=us-east-1


# =========================
# Presigned URLs
# =========================

PRESIGNED_URL_EXPIRY_SECONDS=3600


# =========================
# Multipart Upload
# =========================

UPLOAD_DEFAULT_CHUNK_SIZE_MB=10
UPLOAD_INIT_BATCH_SIZE=20


# =========================
# Orphan File Cleanup
# =========================

ORPHAN_CLEANUP_INTERVAL_MINUTES=30
ORPHAN_CLEANUP_THRESHOLD_MINUTES=60

# =========================
# AI assistant (Hermes agent / FastMCP / Chroma)
# =========================

OPENROUTER_API_KEY=sk-or-REPLACE-ME
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ASSISTANT_HERMES_MODEL=nousresearch/hermes-4-405b


# REQUIRED, >=32 chars; the app refuses to start otherwise. Generate: openssl rand -hex 32
ASSISTANT_SCOPE_TOKEN_SECRET=

ASSISTANT_SCOPE_TOKEN_TTL_SECONDS=300
ASSISTANT_CONTEXT_TTL_SECONDS=120


ASSISTANT_ALLOW_MESSAGE_CONTEXT=false

ASSISTANT_MAX_CONTEXT_MESSAGES=100
ASSISTANT_MAX_CONTEXT_BYTES=1000000
ASSISTANT_RECENT_MESSAGES_LIMIT=20
ASSISTANT_MAX_SEARCH_RESULTS=8
ASSISTANT_RUN_TIMEOUT_SECONDS=120
ASSISTANT_MAX_CONCURRENT_RUNS=4
ASSISTANT_MAX_ITERATIONS=12
# Python used to run the Hermes worker. Empty = /opt/hermes-venv in Docker, else this interpreter.
# Local dev: create a venv with `pip install -r requirements-hermes.txt` and point this at it.
ASSISTANT_HERMES_PYTHON=
ASSISTANT_QUEUE_TIMEOUT_SECONDS=30
ASSISTANT_MAX_OUTPUT_TOKENS=1200
ASSISTANT_MCP_INTERNAL_URL=http://127.0.0.1:8000/mcp/
ASSISTANT_DOCUMENT_INDEXING_ENABLED=true
ASSISTANT_MAX_DOCUMENT_BYTES=26214400
ASSISTANT_MAX_DOCUMENT_CHARS=500000
ASSISTANT_CHUNK_SIZE_CHARS=1200
ASSISTANT_CHUNK_OVERLAP_CHARS=200

CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION_NAME=chat_documents